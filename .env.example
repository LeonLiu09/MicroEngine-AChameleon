# 复制为 .env 后填写。真实 .env 已被 Git 忽略，不要提交密码。
SKILLSWAP_ADMIN_EMAIL=
SKILLSWAP_ADMIN_PASSWORD=
SKILLSWAP_ADMIN_NAME=超级管理员

# 设为 1 后，重启服务会把邮箱、名称和密码同步到已配置管理员。
SKILLSWAP_ADMIN_SYNC=1

# 可选配置
SKILLSWAP_HOST=127.0.0.1
SKILLSWAP_PORT=4173
SKILLSWAP_DB_PATH=data/skillswap.db
SKILLSWAP_SKILLS_DB_PATH=data/skills.db
SKILLSWAP_SECURE_COOKIE=0
